# GapFinder AI - Environment Configuration

# Next.js Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API (Server-side LLM & Embeddings)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL & Auth (Optional - falls back to first-class persistent Demo Mode if omitted)
# Get your keys at: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vector Search Dimensions (Default: 768 for Gemini text-embedding-004)
EMBEDDING_DIMENSIONS=768
